{
  "name": "@acode/workflow-run-read",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "node ../../scripts/clean-dist.mjs",
