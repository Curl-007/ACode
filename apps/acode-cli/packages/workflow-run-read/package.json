    "lint": "oxlint src",
    "lint:fix": "oxlint --write src"
  },
  "dependencies": {
    "@acode/adapters": "workspace:*",
    "@acode/contracts": "workspace:*",
    "@acode/dynamic-workflow": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
