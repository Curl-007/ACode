{
  "name": "acode",
  "version": "0.0.5",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev:web": "concurrently -k -n server,web -c blue,green \"pnpm --filter @acode/server dev\" \"pnpm --filter @acode/web dev\"",
    "dev:desktop": "pnpm run dev:desktop:prod",
    "dev:desktop:test": "node scripts/dev-desktop-env.mjs test",
    "dev:desktop:prod": "node scripts/dev-desktop-env.mjs production",
    "dev:desktop:bytecode": "node scripts/dev-desktop-env.mjs production --agent-bytecode",
    "dev:desktop:remote-prod": "node scripts/dev-desktop-remote-prod.mjs",
    "dev:server": "pnpm --filter @acode/server dev",
    "prepare": "husky",
    "prepare:desktop-runtime": "pnpm --filter @acode/desktop prepare:runtime-assets",
    "dep:graph": "node scripts/dependency-graph.mjs",
    "dep:refs": "node scripts/dep-refs.mjs",
    "verify:pre-push": "pnpm run lint && pnpm run architecture:check -- --changed",
    "build": "pnpm -r build",
    "build:desktop-agent:bytecode": "node scripts/build-desktop-agent-bytecode.mjs",
    "build:acode": "node scripts/build-acode.mjs",
    "build:bootstrap": "pnpm -r --filter \"./packages/*\" --filter \"!@acode/desktop\" build && pnpm --filter @acode/desktop build:no-runtime-assets",
    "build:sea": "pnpm --dir apps/acode-cli build:sea",
    "build:sea:all": "pnpm install && pnpm --dir apps/acode-cli build:sea",
    "build:native-search": "node scripts/build-native-search-tools.mjs",
    "pack:native-search": "node scripts/package-native-search-tools.mjs",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -b packages/rpc packages/provider packages/provider-node packages/shared packages/harness-sdk packages/services packages/client packages/server packages/acode-server-cli packages/ui packages/web packages/desktop/tsconfig.host.json packages/desktop/tsconfig.main.json packages/desktop/tsconfig.preload.json packages/desktop/tsconfig.scheduler.json",
    "bundle:desktop": "pnpm --filter @acode/desktop run bundle --",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "knip",
    "knip:gate": "knip --include files,dependencies,devDependencies,binaries",
    "count-lines": "bash scripts/count-lines.sh",
    "prepare:remote-assets": "pnpm --filter @acode/desktop prepare:remote-assets",
    "doctor:macos-release": "bash scripts/doctor-macos-release-app.sh",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "bootstrap": "node scripts/bootstrap.mjs",
    "bootstrap:with-remote": "node scripts/bootstrap.mjs --with-remote",
    "release": "release-it",
    "release:cli": "pnpm --dir apps/acode-cli run release",
    "release:cli:dry": "pnpm --dir apps/acode-cli run release:dry",
    "architecture:check": "node scripts/architecture/architecture-check.mjs check",
    "architecture:report": "node scripts/architecture/architecture-check.mjs report",
    "architecture:baseline:update": "node scripts/architecture/architecture-check.mjs baseline:update",
    "architecture:context": "node scripts/architecture/architecture-check.mjs context"
  },
  "dependencies": {
    "border-beam": "^1.0.1"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^10.0.6",
    "@tanstack/react-virtual": "^3.13.23",
    "@types/node": "^25.5.0",
    "concurrently": "^9.1.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "husky": "^9.1.7",
    "knip": "^6.0.6",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.57.0",
    "release-it": "^19.2.4",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.4",
    "turbo": "^2.4.0",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "@tanstack/react-virtual": "^3.13.23"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "shell-quote@1": "^1.9.0",
      "axios@1": "^1.15.2",
      "undici@6": "^6.28.0",
      "undici@7": "^7.28.0",
      "protobufjs@7": "^7.5.6",
      "@protobufjs/utf8@1": "^1.1.1",
      "fast-uri@3": "^3.1.6",
      "nanoid@3": "^3.3.18",
      "nanoid@5": "^5.1.16",
      "form-data@4": "^4.0.6",
      "ws@8": "^8.21.0",
      "js-yaml@4": "^4.3.2",
      "basic-ftp@5": "^5.3.1",
      "brace-expansion@1": "^1.1.17",
      "brace-expansion@2": "^2.1.3",
      "brace-expansion@5": "^5.0.9",
      "browserslist@4": "^4.28.7",
      "builder-util-runtime@9": "^9.7.0",
      "hono@4": "^4.12.25",
      "ip-address@10": "^10.5.1",
      "postcss@8": "^8.5.18",
      "smol-toml@1": "^1.7.1",
      "mermaid@11": "^11.16.1",
      "dompurify@3": "^3.4.16",
      "linkify-it@3": "^5.0.2",
      "tar@7": "^7.5.21",
      "tinypool@2": "^2.1.2",
      "source-map-js@1": "^1.2.2",
      "@xmldom/xmldom@0.8": "^0.8.15",
      "tmp@0": "^0.2.6"
    },
    "patchedDependencies": {
      "@ai-sdk/openai-compatible@2.0.60": "patches/@ai-sdk__openai-compatible@2.0.60.patch",
      "@ai-sdk/anthropic@3.0.81": "patches/@ai-sdk__anthropic@3.0.81.patch"
    }
  }
}
