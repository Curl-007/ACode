{
  "name": "@acode/acode-cua",
  "version": "0.6.3",
  "private": true,
  "description": "API-compatible Computer Use package. Server/Helper surfaces are inert fail-closed (every method reports unavailable). The client wire surface (broker.js socket client + index.js createComputerUseRuntime) is a full implementation: it is gated off by (a) absent brokerSocketPath by default and (b) upstream workspace plugin enablement in services; dev env knobs (ACODE_CUA_DEV_MODE / ACODE_CUA_PRODUCT_HELPER) activate the live path.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./frame-contract": {
      "types": "./frame-contract.d.ts",
      "import": "./frame-contract.js"
    },
    "./host-display-contract": {
      "types": "./host-display-contract.d.ts",
      "import": "./host-display-contract.js"
    },
    "./request-access-contract": {
      "types": "./request-access-contract.d.ts",
      "import": "./request-access-contract.js"
    },
    "./pip-session": {
      "types": "./pip-session.d.ts",
      "import": "./pip-session.js"
    },
    "./pip-session/node": {
      "types": "./pip-session-node.d.ts",
      "import": "./pip-session-node.js"
    },
    "./broker": {
      "types": "./broker.d.ts",
      "import": "./broker.js"
    },
    "./broker/server": {
      "types": "./broker-server.d.ts",
      "import": "./broker-server.js"
    },
    "./broker/ports": {
