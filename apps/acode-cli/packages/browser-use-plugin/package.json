{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@acode/browser-use-plugin",
  "version": "0.5.1",
  "private": true,
  "description": "作为官方 ACode 内置插件发布的 Browser Use skill 与 client runtime；node_repl MCP server 由 @acode/node-repl-host 提供。",
  "license": "MIT",
  "type": "module",
  "main": "./dist/mcp/server.js",
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "clean": "node ../../scripts/clean-dist.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src --no-ignore"
  },
  "dependencies": {
    "@acode/core": "workspace:*",
    "@acode/node-repl-host": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
